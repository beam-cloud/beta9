  "findings": [
    {
      "severity": "availability gap",
      "scope": "staging Okteto",
      "observed_configuration": true,
      "detail": "A single selected pod runs the gateway as a replaceable child with no readiness probe. The pod stays Ready while its child stops/restarts. There is no second public target to serve during the listener gap."
    },
    {
      "severity": "unverified normal deployment continuity",
      "scope": "production",
      "observed_configuration": true,
      "detail": "Three ready targets and zone spreading provide redundancy, but Kubernetes readiness is not gated on AWS target health. New pods can satisfy rollout availability before NLB registration/health convergence. This is a configuration risk; no production failure was induced or observed."
    },
    {
      "severity": "connection drain mismatch",
      "scope": "staging and production",
      "observed_configuration": true,
      "detail": "Actual AWS target groups terminate connections immediately when a target becomes unhealthy (drain interval0), and after30s of deregistration. These settings can truncate established HTTP/SSE connections before the gateway180s request-drain budget expires."
    },
    {
      "severity": "supervisor shutdown budget",
      "scope": "staging Okteto",
      "observed_configuration": true,
      "detail": "Root traced the active old helper10s force-kill budget conflicting with gateway10s readiness propagation. A195s helper fix is prepared/tested locally but has not been activated in the existing watcher."
    }
  ],
  "smallest_correct_staging_ha_workflow": [
    "Add one temporary standby pod selected by the same gateway services, using the same already-built Linux gateway binary and existing runtime image/config; do not scale up the old packaged gateway binary against the new endpoint schema.",
    "Enable working readiness probes and a195s pod termination grace. Wait for both Kubernetes readiness and actual AWS target health before touching either serving gateway.",
    "Keep the standby on the known-good binary; update only one gateway at a time. Two watchers must not automatically reload the same source simultaneously.",
    "Align staging NLB connection draining with the intended graceful request budget before claiming uninterrupted long requests. These load-balancer changes have not been applied or authorized by this review.",
    "Validate the complete swap with continuous new HTTP requests and an established long request/SSE stream, recording errors and container identities. A retry succeeding afterward is not sufficient evidence of a gap-free reload."
  ]
