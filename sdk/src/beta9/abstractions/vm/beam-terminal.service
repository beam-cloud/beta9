[Unit]
Description=Beam VM browser terminal
After=network.target

[Service]
Type=exec
WorkingDirectory=/workspace
Environment=HOME=/root
ExecStart=/usr/local/bin/ttyd --interface 0.0.0.0 --port 7681 --writable /bin/bash -l
Restart=on-failure
RestartSec=1
KillMode=control-group

[Install]
WantedBy=multi-user.target
