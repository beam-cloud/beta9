#!/bin/bash
set -euo pipefail

# Select the session account once; both modes use the same trust and supervisor.
run_as=()
if [ -z "${BEAM_VM_KIOSK:-}" ]; then
  read -r desktop_user < /opt/beam-vm/desktop-user
  # The worker overlays /workspace with a fresh root-owned directory.
  chown "$desktop_user:$desktop_user" /run/beam-desktop /workspace
  desktop_home=$(getent passwd "$desktop_user" | cut -d: -f6)
  export XDG_CONFIG_HOME="$desktop_home/.config"
  run_as=(runuser -u "$desktop_user" --)
fi
if [ "${1:-}" = --launch ]; then
  shift
  exec "${run_as[@]}" "$@"
fi
"${run_as[@]}" /opt/beam-vm/browser-trust
exec "${run_as[@]}" /opt/beam-vm/kiosk
