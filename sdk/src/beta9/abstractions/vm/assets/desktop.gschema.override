[org.gnome.desktop.interface:ubuntu]
scaling-factor=uint32 @PIXEL_RATIO@
text-scaling-factor=1.0
toolkit-accessibility=true
enable-animations=false

[org.gnome.desktop.session:ubuntu]
idle-delay=uint32 0

[org.gnome.desktop.screensaver:ubuntu]
lock-enabled=false

[org.gnome.desktop.lockdown:ubuntu]
disable-lock-screen=true

[org.gnome.desktop.background:ubuntu]
picture-uri=''
picture-uri-dark=''
primary-color='#17171c'
color-shading-type='solid'

[org.gnome.shell:ubuntu]
favorite-apps=['beam-browser.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop']
