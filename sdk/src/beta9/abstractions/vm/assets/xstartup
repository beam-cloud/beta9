#!/bin/bash
set -euo pipefail

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export DISPLAY=:1 XAUTHORITY=/run/beam-desktop/.Xauthority

# Font DPI and GTK density are set by the shared display supervisor.
xrdb -merge <<'EOF'
Xft.antialias: 1
Xft.hintstyle: hintslight
Xft.rgba: none
XTerm*faceName: Ubuntu Mono
XTerm*faceSize: 12
XTerm*renderFont: true
XTerm*background: #17171c
XTerm*foreground: #ededee
EOF
if [ -f "$HOME/.Xresources" ]; then
  xrdb -merge "$HOME/.Xresources" || echo 'Unable to load ~/.Xresources; continuing' >&2
fi

xsetroot -solid '#17171c'
export XDG_CURRENT_DESKTOP=ubuntu:GNOME DESKTOP_SESSION=ubuntu XDG_SESSION_TYPE=x11
export GNOME_SHELL_SESSION_MODE=ubuntu
export XDG_CONFIG_DIRS="/etc/xdg/xdg-ubuntu:${XDG_CONFIG_DIRS:-/etc/xdg}"
if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
  exec gnome-session --session=ubuntu
fi
exec dbus-run-session -- gnome-session --session=ubuntu
