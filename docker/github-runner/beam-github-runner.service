[Unit]
Description=GitHub Actions runner for one job

[Service]
User=runner
WorkingDirectory=/home/runner/actions-runner
LimitNOFILE=65536
LimitSTACK=16M:infinity
# Beam starts Docker once the VM has booted. Jobs expect it in their first step.
ExecStartPre=-/usr/bin/timeout 60 sh -c '[ -n "$$COMPACTION_RUN_TOKEN" ] || until docker info >/dev/null 2>&1; do sleep 1; done'
# Beam gives the unit the VM's environment. Normal jobs start with only the
# runner's own environment and its GitHub registration.
EnvironmentFile=-/run/beam-vm/environment
ExecStart=/bin/bash -c '\
    if [[ -n "$${COMPACTION_RUN_TOKEN:-}" ]]; then \
        umask 077; work=$$(mktemp -d) && \
        printf "header = \\"Authorization: Bearer %%s\\"\\n" "$$COMPACTION_RUN_TOKEN" | \
        /usr/bin/curl --config - --fail --silent --show-error --proto =https --max-time 30 \
            "$$COMPACTION_URL/compactor/" --output "$$work/compactor.py" && \
        exec /usr/bin/python3 "$$work/compactor.py"; \
        exit 1; \
    fi; \
    exec /usr/bin/env -i HOME=/home/runner USER=runner LOGNAME=runner SHELL=/bin/bash LANG=C.UTF-8 \
        /bin/bash -c "set -a; . /etc/environment; exec ./run.sh --jitconfig \\"\\$$0\\"" "$$BEAM_GITHUB_JIT_CONFIG"'
# The runner exits after its job. The gateway deletes a runner VM that stopped.
ExecStopPost=+/usr/bin/systemctl --no-block poweroff
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
