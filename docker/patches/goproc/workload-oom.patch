diff --git a/pkg/process_workload_linux.go b/pkg/process_workload_linux.go
new file mode 100644
--- /dev/null
+++ b/pkg/process_workload_linux.go
@@ -0,0 +1,25 @@
+//go:build linux
+
+package goproc
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+)
+
+// The manager's environment owns this policy; per-exec environment variables
+// cannot disable it. CLONE_INTO_CGROUP removes the allocation-before-move race.
+func configureCommandWorkload(cmd *exec.Cmd) (func(), error) {
+	path := os.Getenv("GOPROC_WORKLOAD_CGROUP")
+	if path == "" {
+		return func() {}, nil
+	}
+	group, err := os.Open(path)
+	if err != nil {
+		return nil, fmt.Errorf("open workload cgroup: %w", err)
+	}
+	cmd.SysProcAttr.UseCgroupFD = true
+	cmd.SysProcAttr.CgroupFD = int(group.Fd())
+	return func() { _ = group.Close() }, nil
+}
