     }
 
+    #[test]
+    fn snapshot_block_queues_reject_pending_without_mutating_the_queue() {
+        use vm_memory::Bytes;
+
+        let mut device = make_virtio_pci_device_with_queues(2);
+        let queue = &mut device.queues[1];
+        queue
+            .try_set_avail_ring_address(GuestAddress(0x100))
+            .unwrap();
+        queue
+            .try_set_used_ring_address(GuestAddress(0x200))
+            .unwrap();
+        queue.set_ready(true);
+        let memory = device.memory.memory();
+        memory
+            .write_obj(733_u16.to_le(), GuestAddress(0x102))
+            .unwrap();
+        memory
+            .write_obj(720_u16.to_le(), GuestAddress(0x202))
+            .unwrap();
+
+        assert!(matches!(
+            device.check_snapshot_queues(),
+            Err(MigratableError::SnapshotBlockQueuesBusy {
+                queue: 1,
+                available: 733,
+                used: 720,
+                ..
+            })
+        ));
+        assert_eq!(
+            memory.read_obj::<u16>(GuestAddress(0x202)).unwrap(),
+            720_u16.to_le()
+        );
+        memory
+            .write_obj(733_u16.to_le(), GuestAddress(0x202))
+            .unwrap();
+        device.check_snapshot_queues().unwrap();
+    }
+
+    #[test]
+    fn snapshot_block_queues_handle_wrap_and_reject_unreadable_indices() {
+        use vm_memory::Bytes;
+
+        let mut device = make_virtio_pci_device_with_queues(1);
+        // An unconfigured queue has no requests and must not read address zero.
+        device.check_snapshot_queues().unwrap();
+        let queue = &mut device.queues[0];
+        queue
+            .try_set_avail_ring_address(GuestAddress(0x100))
+            .unwrap();
+        queue
+            .try_set_used_ring_address(GuestAddress(0x200))
+            .unwrap();
+        queue.set_ready(true);
+        let memory = device.memory.memory();
+        memory.write_obj(0_u16, GuestAddress(0x102)).unwrap();
+        memory
+            .write_obj(u16::MAX.to_le(), GuestAddress(0x202))
+            .unwrap();
+        assert!(matches!(
+            device.check_snapshot_queues(),
+            Err(MigratableError::SnapshotBlockQueuesBusy { .. })
+        ));
+        memory.write_obj(0_u16, GuestAddress(0x202)).unwrap();
+        device.check_snapshot_queues().unwrap();
+        device.queues[0]
+            .try_set_used_ring_address(GuestAddress(0x2000))
+            .unwrap();
+        assert!(matches!(
+            device.check_snapshot_queues(),
+            Err(MigratableError::Snapshot(_))
+        ));
+    }
