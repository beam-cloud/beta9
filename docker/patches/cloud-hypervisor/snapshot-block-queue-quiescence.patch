+        if self.get_state() != VmState::Paused {
+            return Err(MigratableError::Snapshot(anyhow!(
+                "Trying to snapshot while VM is running"
+            )));
+        }
+        self.device_manager
+            .lock()
+            .unwrap()
+            .check_snapshot_block_queues()
+    }
+}
