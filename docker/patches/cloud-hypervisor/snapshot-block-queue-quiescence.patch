+    /// Check before any device snapshot can stop a backend. The caller must
+    /// have paused the vCPUs: no new available descriptors can then appear.
+    /// A vhost-user block backend without saved inflight state cannot restore
+    /// requests present in the available ring but absent from the used ring.
+    pub fn check_snapshot_queues(&self) -> result::Result<(), MigratableError> {
+        let memory = self.memory.memory();
+        for (index, queue) in self.queues.iter().enumerate() {
+            if !queue.ready() {
+                continue;
+            }
+            let available = queue
+                .avail_idx(memory.deref(), Ordering::Acquire)
+                .context("Failed reading available block queue index")
+                .map_err(MigratableError::Snapshot)?
+                .0;
+            let used = queue
+                .used_idx(memory.deref(), Ordering::Acquire)
+                .context("Failed reading used block queue index")
+                .map_err(MigratableError::Snapshot)?
+                .0;
+            if available != used {
+                return Err(MigratableError::SnapshotBlockQueuesBusy {
+                    device: self.id.clone(),
+                    queue: index,
+                    available,
+                    used,
+                });
+            }
+        }
+        Ok(())
+    }
+
