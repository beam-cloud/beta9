diff --git a/vmm/src/device_manager.rs b/vmm/src/device_manager.rs
index 416132e..f10f5ef 100644
--- a/vmm/src/device_manager.rs
+++ b/vmm/src/device_manager.rs
@@ -5940,6 +5940,35 @@ impl Pausable for DeviceManager {
     }
 }
 
+impl DeviceManager {
+    /// Reject a busy block queue before snapshotting any other device. In
+    /// particular, virtiofs backend capture may stop its queues permanently.
+    pub fn check_snapshot_block_queues(&self) -> result::Result<(), MigratableError> {
+        let config = self.config.lock().unwrap();
+        let Some(disks) = &config.disks else {
+            return Ok(());
+        };
+        let device_tree = self.device_tree.lock().unwrap();
+        for disk in disks.iter().filter(|disk| disk.vhost_user) {
+            let transport = disk
+                .pci_common
+                .id
+                .as_ref()
+                .and_then(|id| device_tree.get(id))
+                .and_then(|node| node.parent.as_ref())
+                .and_then(|id| device_tree.get(id))
+                .and_then(|node| node.pci_device_handle.as_ref());
+            let Some(PciDeviceHandle::Virtio(device)) = transport else {
+                return Err(MigratableError::Snapshot(anyhow!(
+                    "Missing vhost-user block PCI transport"
+                )));
+            };
+            device.lock().unwrap().check_snapshot_queues()?;
+        }
+        Ok(())
+    }
+}
+
