+	size_t bufsize = clamp((unsigned int) ctx->count, PAGE_SIZE, fc->max_pages << PAGE_SHIFT);
 	u64 attr_version = 0, evict_ctr = 0;
 	bool locked;
-
-	folio = folio_alloc(GFP_KERNEL, 0);
-	if (!folio)
+	struct page **pages = fuse_readdir_alloc_buf(ap, &bufsize);
+
+	if (!pages)
 		return -ENOMEM;
-
