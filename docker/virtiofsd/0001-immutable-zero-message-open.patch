+#[cfg(test)]
+mod zero_open_tests {
+    use super::*;
+    use std::os::unix::fs::FileExt;
+    use std::sync::atomic::Ordering;
+
+    #[test]
+    fn immutable_opens_and_migration() -> io::Result<()> {
+        let root = std::env::temp_dir().join(format!(
+            "virtiofsd-zero-open-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        std::fs::create_dir(&root)?;
+        std::fs::write(root.join("file"), b"contents")?;
+        let config = || super::super::Config {
+            root_dir: root.to_str().unwrap().to_string(),
+            cache_policy: super::super::CachePolicy::Always,
+            inode_file_handles: super::super::InodeFileHandlesMode::Never,
+            ..Default::default()
+        };
+        let capable = FsOptions::ZERO_MESSAGE_OPEN | FsOptions::ZERO_MESSAGE_OPENDIR;
+        assert!(!PassthroughFs::new(config())?
+            .init(capable)?
+            .intersects(capable));
+        assert!(!PassthroughFsRo::new(config())?
+            .init(FsOptions::empty())?
+            .intersects(capable));
+        let mut auto = config();
+        auto.cache_policy = super::super::CachePolicy::Auto;
+        assert!(!PassthroughFsRo::new(auto)?
+            .init(capable)?
+            .intersects(capable));
+        let fs = PassthroughFsRo::new(config())?;
+        let opts = fs.init(capable)?;
+        assert!(opts.contains(FsOptions::ZERO_MESSAGE_OPEN));
+        assert!(opts.contains(FsOptions::ZERO_MESSAGE_OPENDIR));
+        let ctx = Context {
+            uid: 0.into(),
+            gid: 0.into(),
+            pid: 0,
+        };
+        let file_only = PassthroughFsRo::new(config())?;
+        assert!(!file_only
+            .init(FsOptions::ZERO_MESSAGE_OPEN)?
+            .contains(FsOptions::ZERO_MESSAGE_OPENDIR));
+        let (dir, _) = file_only.opendir(ctx, fuse::ROOT_ID, 0)?;
+        file_only.fsyncdir(ctx, fuse::ROOT_ID, false, dir.unwrap())?;
+        file_only.releasedir(ctx, fuse::ROOT_ID, 0, dir.unwrap())?;
+        let entry = fs.lookup(
+            ctx,
+            fuse::ROOT_ID,
+            CStr::from_bytes_with_nul(b"file\0").unwrap(),
+        )?;
+        assert_eq!(
+            fs.open(ctx, entry.inode, false, libc::O_RDONLY as u32)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::ENOSYS)
+        );
+        assert_eq!(
+            fs.open(ctx, entry.inode, false, libc::O_WRONLY as u32)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::EROFS)
+        );
+        assert_eq!(
+            fs.flush(ctx, entry.inode, 0, 0).unwrap_err().raw_os_error(),
+            Some(libc::ENOSYS)
+        );
+        assert_eq!(
+            fs.opendir(ctx, fuse::ROOT_ID, 0)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::ENOSYS)
+        );
+        for i in 0..300 {
+            std::fs::write(root.join(format!("page-{i}")), b"x")?;
+        }
+        let mut offset = 0;
+        let mut names = std::collections::HashSet::new();
+        loop {
+            let mut iter = fs.readdir(ctx, fuse::ROOT_ID, 0, 1024, offset)?;
+            let mut count = 0;
+            while let Some(e) = crate::filesystem::DirectoryIterator::next(&mut iter) {
+                assert!(names.insert(e.name.to_bytes().to_vec()));
+                offset = e.offset;
+                count += 1;
+            }
+            if count == 0 {
+                break;
+            }
+        }
+        assert_eq!(names.len(), 303); // '.', '..', 'file', and 300 paged entries
+
+        fs.fsync(ctx, entry.inode, false, 0)?;
+        fs.fsyncdir(ctx, fuse::ROOT_ID, false, 0)?;
+        let handle = fs.0.find_handle(0, entry.inode)?;
+        let file = handle.file.get()?;
+        let mut bytes = [0; 8];
+        file.read().unwrap().get_file().read_at(&mut bytes, 0)?;
+        assert_eq!(&bytes, b"contents");
+        assert!(fs.0.handles.read().unwrap().is_empty());
+        fs.prepare_serialization(Arc::new(AtomicBool::new(false)));
+        fs.serialize(File::create(root.join("state"))?)?;
+        let restored = PassthroughFsRo::new(config())?;
+        restored.deserialize_and_apply(File::open(root.join("state"))?)?;
+        assert!(restored.0.no_open.load(Ordering::Relaxed));
+        assert!(restored.0.no_opendir.load(Ordering::Relaxed));
+        assert!(restored.0.find_handle(0, entry.inode).is_ok());
+        assert!(restored.readdir(ctx, fuse::ROOT_ID, 0, 1024, 0).is_ok());
+        std::fs::remove_dir_all(root)?;
+        Ok(())
+    }
+}
