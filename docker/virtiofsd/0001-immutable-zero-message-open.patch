+#[cfg(test)]
+mod stateless_migration_tests {
+    use super::*;
+    use crate::filesystem::{FileSystem, FsOptions};
+    use crate::passthrough::{Config, InodeFileHandlesMode};
+
+    #[test]
+    fn legacy_restore_clears_stale_stateless_flags() -> io::Result<()> {
+        let root = std::env::temp_dir().join(format!(
+            "virtiofsd-v3-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        std::fs::create_dir(&root)?;
+        let config = || Config {
+            root_dir: root.to_str().unwrap().into(),
+            inode_file_handles: InodeFileHandlesMode::Never,
+            ..Default::default()
+        };
+        let source = PassthroughFs::new(config())?;
+        source.init(FsOptions::empty())?;
+        source.no_open.store(true, Ordering::Relaxed);
+        source.prepare_serialization(Arc::new(AtomicBool::new(false)));
+        for version in 1..=3 {
+            let v2: serialized::PassthroughFsV2 = (&source).into();
+            let state = match version {
+                1 => serialized::PassthroughFs::V1(v2.v1),
+                2 => serialized::PassthroughFs::V2(v2),
+                _ => {
+                    serialized::PassthroughFs::V3(serialized::PassthroughFsV3 { v2, no_open: true })
+                }
+            };
+            let bytes: Vec<u8> = state.try_into()?;
+            std::fs::write(root.join("state"), bytes)?;
+            let target = PassthroughFs::new(config())?;
+            target.no_open.store(true, Ordering::Relaxed);
+            target.no_opendir.store(true, Ordering::Relaxed);
+            target.deserialize_and_apply(File::open(root.join("state"))?)?;
+            assert_eq!(target.no_open.load(Ordering::Relaxed), version == 3);
+            assert!(!target.no_opendir.load(Ordering::Relaxed));
+        }
+        std::fs::remove_dir_all(root)?;
+        Ok(())
+    }
