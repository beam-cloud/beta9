+#[cfg(test)]
+mod immutable_open_tests {
+    use super::*;
+    use std::os::unix::fs::FileExt;
+    use std::os::unix::io::AsRawFd;
+    use std::sync::atomic::Ordering;
+    struct Fixture(std::path::PathBuf);
+    impl Fixture {
+        fn new() -> io::Result<Self> {
+            let p = std::env::temp_dir().join(format!(
+                "immutable-open-{}-{}",
+                std::process::id(),
+                std::time::SystemTime::now()
+                    .duration_since(std::time::UNIX_EPOCH)
+                    .unwrap()
+                    .as_nanos()
+            ));
+            std::fs::create_dir(&p)?;
+            std::fs::write(p.join("file"), b"contents")?;
+            Ok(Self(p))
+        }
+        fn cfg(&self) -> super::super::Config {
+            super::super::Config {
+                root_dir: self.0.to_str().unwrap().into(),
+                cache_policy: super::super::CachePolicy::Always,
+                immutable_open: true,
+                inode_file_handles: super::super::InodeFileHandlesMode::Never,
+                ..Default::default()
+            }
+        }
+    }
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            let _ = std::fs::remove_dir_all(&self.0);
+        }
+    }
+    fn context() -> Context {
+        Context {
+            uid: 0.into(),
+            gid: 0.into(),
+            pid: 0,
+        }
+    }
+    fn capable() -> FsOptions {
+        FsOptions::ZERO_MESSAGE_OPEN | FsOptions::ZERO_MESSAGE_OPENDIR
+    }
+    fn file(fs: &PassthroughFsRo) -> io::Result<Entry> {
+        fs.lookup(
+            context(),
+            fuse::ROOT_ID,
+            CStr::from_bytes_with_nul(b"file\0").unwrap(),
+        )
+    }
+    #[test]
+    fn explicit_readonly_policy_and_independent_negotiation() -> io::Result<()> {
+        let f = Fixture::new()?;
+        assert!(!PassthroughFs::new(f.cfg())?
+            .init(capable())?
+            .intersects(capable()));
+        let mut c = f.cfg();
+        c.immutable_open = false;
+        assert!(!PassthroughFsRo::new(c)?
+            .init(capable())?
+            .intersects(capable()));
+        for bit in [
+            FsOptions::empty(),
+            FsOptions::ZERO_MESSAGE_OPEN,
+            FsOptions::ZERO_MESSAGE_OPENDIR,
+            capable(),
+        ] {
+            let fs = PassthroughFsRo::new(f.cfg())?;
+            let out = fs.init(bit)?;
+            assert_eq!(out & capable(), bit);
+            assert_eq!(
+                fs.0.no_open.load(Ordering::Relaxed),
+                bit.contains(FsOptions::ZERO_MESSAGE_OPEN)
+            );
+            assert_eq!(
+                fs.0.no_opendir.load(Ordering::Relaxed),
+                bit.contains(FsOptions::ZERO_MESSAGE_OPENDIR)
+            );
+        }
+        let mut invalid = Vec::new();
+        let mut c = f.cfg();
+        c.cache_policy = super::super::CachePolicy::Auto;
+        invalid.push(c);
+        let mut c = f.cfg();
+        c.writeback = true;
+        invalid.push(c);
+        let mut c = f.cfg();
+        c.allow_direct_io = true;
+        invalid.push(c);
+        let mut c = f.cfg();
+        c.clean_noatime = false;
+        invalid.push(c);
+        let mut c = f.cfg();
+        c.posix_acl = super::super::NegotiationMode::Always;
+        invalid.push(c);
+        for c in invalid {
+            assert!(PassthroughFsRo::new(c).is_err());
+        }
+        Ok(())
+    }
+    #[test]
+    fn ephemeral_pread_handles_forget_and_readonly_flags() -> io::Result<()> {
+        let f = Fixture::new()?;
+        let fs = PassthroughFsRo::new(f.cfg())?;
+        fs.init(capable())?;
+        let entry = file(&fs)?;
+        assert_eq!(
+            fs.open(context(), entry.inode, false, libc::O_RDONLY as u32)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::ENOSYS)
+        );
+        for (flags, errno) in [
+            (libc::O_WRONLY, libc::EROFS),
+            (libc::O_RDWR, libc::EROFS),
+            (libc::O_TRUNC, libc::EINVAL),
+            (libc::O_CREAT | libc::O_EXCL, libc::EROFS),
+        ] {
+            assert_eq!(
+                fs.open(context(), entry.inode, false, flags as u32)
+                    .unwrap_err()
+                    .raw_os_error(),
+                Some(errno)
+            );
+        }
+        assert_eq!(
+            fs.flush(context(), entry.inode, 0, 0)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::ENOSYS)
+        );
+        let a = fs.0.find_handle(0, entry.inode)?;
+        let b = fs.0.find_handle(0, entry.inode)?;
+        assert!(!Arc::ptr_eq(&a, &b));
+        assert_ne!(
+            a.file.get()?.read().unwrap().as_raw_fd(),
+            b.file.get()?.read().unwrap().as_raw_fd()
+        );
+        let mut data = [0; 8];
+        a.file
+            .get()?
+            .read()
+            .unwrap()
+            .get_file()
+            .read_at(&mut data, 0)?;
+        assert_eq!(&data, b"contents");
+        fs.fsync(context(), entry.inode, false, 0)?;
+        let weak = Arc::downgrade(&a);
+        drop(a);
+        assert!(weak.upgrade().is_none());
+        let weak_b = Arc::downgrade(&b);
+        fs.forget(context(), entry.inode, 1);
+        drop(b);
+        assert!(weak_b.upgrade().is_none());
+        assert!(fs.0.find_handle(0, entry.inode).is_err());
+        assert!(fs.0.handles.read().unwrap().is_empty());
+        Ok(())
+    }
+    #[test]
+    fn concurrent_paged_directory_uses_fresh_descriptions() -> io::Result<()> {
+        let f = Fixture::new()?;
+        for i in 0..300 {
+            std::fs::write(f.0.join(format!("page-{i}")), b"x")?;
+        }
+        let fs = Arc::new(PassthroughFsRo::new(f.cfg())?);
+        fs.init(capable())?;
+        assert_eq!(
+            fs.opendir(context(), fuse::ROOT_ID, 0)
+                .unwrap_err()
+                .raw_os_error(),
+            Some(libc::ENOSYS)
+        );
+        let mut threads = Vec::new();
+        for _ in 0..2 {
+            let fs = Arc::clone(&fs);
+            threads.push(std::thread::spawn(move || -> io::Result<()> {
+                let mut offset = 0;
+                let mut names = std::collections::HashSet::new();
+                loop {
+                    let mut iter = fs.readdir(context(), fuse::ROOT_ID, 0, 1024, offset)?;
+                    let mut n = 0;
+                    while let Some(e) = crate::filesystem::DirectoryIterator::next(&mut iter) {
+                        assert!(names.insert(e.name.to_bytes().to_vec()));
+                        offset = e.offset;
+                        n += 1;
+                    }
+                    if n == 0 {
+                        break;
+                    }
+                }
+                assert_eq!(names.len(), 303);
+                Ok(())
+            }));
+        }
+        for t in threads {
+            t.join().unwrap()?;
+        }
+        fs.fsyncdir(context(), fuse::ROOT_ID, false, 0)?;
+        let a = fs.0.find_handle(0, fuse::ROOT_ID)?;
+        assert!(!Arc::ptr_eq(&a, &fs.0.find_handle(0, fuse::ROOT_ID)?));
+        Ok(())
+    }
+    #[test]
+    fn migration_restores_negotiation_and_rejects_mutable_destination() -> io::Result<()> {
+        let f = Fixture::new()?;
+        let fs = PassthroughFsRo::new(f.cfg())?;
+        fs.init(capable())?;
+        let entry = file(&fs)?;
+        let before = fs.0.find_handle(0, entry.inode)?;
+        let old_fd = before.file.get()?.read().unwrap().as_raw_fd();
+        let state = f.0.with_extension("state");
+        fs.prepare_serialization(Arc::new(AtomicBool::new(false)));
+        fs.serialize(File::create(&state)?)?;
+        let restored = PassthroughFsRo::new(f.cfg())?;
+        restored.deserialize_and_apply(File::open(&state)?)?;
+        assert!(restored.0.no_open.load(Ordering::Relaxed));
+        assert!(restored.0.no_opendir.load(Ordering::Relaxed));
+        let after = restored.0.find_handle(0, entry.inode)?;
+        assert_ne!(old_fd, after.file.get()?.read().unwrap().as_raw_fd());
+        let mut data = [0; 8];
+        after
+            .file
+            .get()?
+            .read()
+            .unwrap()
+            .get_file()
+            .read_at(&mut data, 0)?;
+        assert_eq!(&data, b"contents");
+        assert!(PassthroughFs::new(f.cfg())?
+            .deserialize_and_apply(File::open(&state)?)
+            .is_err());
+        // Official V2 streams retain ordinary opens, even with the opt-in configured.
+        let legacy = PassthroughFs::new(f.cfg())?;
+        legacy.init(FsOptions::empty())?;
+        legacy.prepare_serialization(Arc::new(AtomicBool::new(false)));
+        legacy.serialize(File::create(&state)?)?;
+        restored.deserialize_and_apply(File::open(&state)?)?;
+        assert!(!restored.0.no_open.load(Ordering::Relaxed));
+        assert!(!restored.0.no_opendir.load(Ordering::Relaxed));
+        std::fs::remove_file(state)?;
+        Ok(())
+    }
