+/// Reserve at most the existing default FD budget while the table is unshared.
+/// The duplicate is closed immediately; no live target FD is overwritten.
+/// Call after the final sandbox fork and before creating any worker threads.
+pub fn preallocate_fd_table(anchor: RawFd, nofile: u64) -> io::Result<()> {
+    let target = cmp::min(nofile, DEFAULT_NOFILE)
+        .checked_sub(1)
+        .and_then(|n| RawFd::try_from(n).ok())
+        .ok_or(io::ErrorKind::InvalidInput)?;
+    if unsafe { libc::fcntl(anchor, libc::F_GETFD) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // A live target means the table already has sufficient capacity. Do not
+    // let F_DUPFD search above the budget when the soft limit is larger.
+    if unsafe { libc::fcntl(target, libc::F_GETFD) } >= 0 {
+        return Ok(());
+    }
+    let error = io::Error::last_os_error();
+    if error.raw_os_error() != Some(libc::EBADF) {
+        return Err(error);
+    }
+    let duplicate = unsafe { libc::fcntl(anchor, libc::F_DUPFD_CLOEXEC, target) };
+    if duplicate < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    drop(unsafe { OwnedFd::from_raw_fd(duplicate) });
+    Ok(())
+}
